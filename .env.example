# Copy to .env for local runs: `set -a; source .env; set +a`
# Get a key at https://aistudio.google.com/apikey — create it in a project WITHOUT billing
# so it stays on the free tier.
GEMINI_API_KEY=

# Optional: Netscape-format cookies from a throwaway Instagram account, if downloads get blocked.
# IG_COOKIES_FILE=./cookies.txt

# Optional overrides
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-flash-latest
# GEMINI_LIGHT_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# DUPLICATE_THRESHOLD=0.95
# AMBIGUOUS_THRESHOLD=0.85
# GROUP_THRESHOLD=0.80
# RELATED_THRESHOLD=0.72
